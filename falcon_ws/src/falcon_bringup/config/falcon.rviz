Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 100
      Color: 120; 120; 120
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Car
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar /lidar/points
      Enabled: true
      Topic:
        Value: /lidar/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Decay Time: 0
      Queue Size: 5
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage (green seen, orange few points, red missed, grey never in view)
      Enabled: true
      Topic:
        Value: /coverage/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage from Gazebo's cloud (coverage_source:=both, upper markers)
      Enabled: true
      Topic:
        Value: /coverage/pointcloud/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Cone map
      Enabled: true
      Topic:
        Value: /map/cone_markers
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner cones and centreline
      Enabled: true
      Topic:
        Value: /planning/cone_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /planning/path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 255; 127
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Lookahead point
      Enabled: true
      Topic:
        Value: /planning/lookahead_marker
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Lidar clusters
      Enabled: true
      Topic:
        Value: /falcon/lidar_cluster_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: SLAM cone map (localization:=slam; ellipse = 2 sigma)
      Enabled: true
      Topic:
        Value: /localization/landmark_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: True path (simulator)
      Enabled: true
      Topic:
        Value: /localization/eval/path_true
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 255; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Estimated path (odometry + SLAM)
      Enabled: true
      Topic:
        Value: /localization/eval/path_est
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Dead reckoning (odometry only)
      Enabled: true
      Topic:
        Value: /localization/eval/path_dr
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 128; 128; 128
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Follow the car
      Target Frame: base_footprint
      Distance: 25
      Pitch: 0.75
      Yaw: 3.14
      Focal Point:
        X: 4
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Value: ThirdPersonFollower (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Displays:
    collapsed: false
  Views:
    collapsed: true
