<?xml version="1.0"?>
<!--
  Cameras for the Falcon car.

  falcon_camera: one RGB-D camera standing in for the ZED.  It keeps the EUFS ZED
  frame names and topics (/zed/image_raw, /zed/depth/image_raw, /zed/camera_info) so
  YOLO and cone_depth_localizer are unchanged, but drops the stereo pair and runs at
  a configurable rate: the EUFS ZED rendered a stereo pair plus a depth camera at
  60 Hz, 1280 x 720, which is heavy without a GPU.

  falcon_teleop_camera: chase view for falcon_teleop, no mesh.

  xyz / rpy are relative to `parent` (urdf_builder.py converts from base_footprint).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="falcon_camera" params="prefix parent xyz rpy hfov width height rate">

    <joint name="${prefix}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_camera_center"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${prefix}_camera_center">
      <visual>
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/zed.dae"/>
        </geometry>
      </visual>
    </link>

    <link name="${prefix}_left_camera_frame"/>
    <link name="${prefix}_right_camera_frame"/>
    <link name="${prefix}_left_camera_optical_frame"/>
    <link name="${prefix}_right_camera_optical_frame"/>
    <link name="${prefix}_depth_camera_frame"/>

    <joint name="${prefix}_left_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_left_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_right_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_right_camera_frame"/>
      <origin xyz="0 -0.06 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_left_camera_optical_joint" type="fixed">
      <parent link="${prefix}_left_camera_frame"/>
      <child link="${prefix}_left_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_right_camera_optical_joint" type="fixed">
      <parent link="${prefix}_right_camera_frame"/>
      <child link="${prefix}_right_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <!-- The depth sensor looks along +x of this frame (Gazebo convention). -->
    <joint name="${prefix}_depth_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_depth_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_depth_camera_frame">
      <sensor name="${prefix}_rgbd" type="depth">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>B8G8R8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>40.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="${prefix}_controller" filename="libgazebo_ros_camera.so">
          <camera_name>${prefix}</camera_name>
          <frame_name>${prefix}_depth_camera_frame</frame_name>
          <hack_baseline>0.120</hack_baseline>
          <min_depth>0.3</min_depth>
          <max_depth>40.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="falcon_teleop_camera" params="parent xyz rpy">
    <joint name="teleop_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="teleop_camera_frame"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="teleop_camera_frame"/>
    <gazebo reference="teleop_camera_frame">
      <sensor type="camera" name="teleop_camera_sensor">
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>800</width>
            <height>450</height>
            <format>B8G8R8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>150</far>
          </clip>
        </camera>
        <plugin name="teleop_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>image_raw:=/teleop_camera/image_raw</remapping>
            <remapping>camera_info:=/teleop_camera/camera_info</remapping>
          </ros>
          <camera_name>teleop_camera</camera_name>
          <frame_name>teleop_camera_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
